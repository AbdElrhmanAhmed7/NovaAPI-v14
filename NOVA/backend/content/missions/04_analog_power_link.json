      "detail": {"en": "Electrical work in spaceflight hardware follows lock-out/tag-out: energy sources are isolated and labelled before maintenance.", "ar": "Electrical work in spaceflight hardware follows lock-out/tag-out: energy sources are isolated and labelled before maintenance."},
      "source": "NASA-STD-8719.24 (payload electrical safety, summarised)",
      "url": "https://standards.nasa.gov/",
      "simulated": true
    }
  ],
  "world_objects": [
    {"id": "power_panel", "label": {"en": "Power Panel", "ar": "Power Panel"}, "kind": "device", "position": [5, 0, -4], "interactions": ["inspect_bus"]},
    {"id": "main_breaker", "label": {"en": "Main Breaker", "ar": "Main Breaker"}, "kind": "switch", "position": [5.8, 1.1, -4], "interactions": ["isolate_breaker", "energise_bus"]},
    {"id": "stores_locker", "label": {"en": "Stores Locker", "ar": "Stores Locker"}, "kind": "locker", "position": [8, 0, 2], "interactions": ["fetch_power_module"]},
    {"id": "power_module_bay", "label": {"en": "Power Module Bay", "ar": "Power Module Bay"}, "kind": "device", "position": [7, 0, -2], "interactions": ["connect_module"]},
    {"id": "solar_frame", "label": {"en": "Solar Frame", "ar": "Solar Frame"}, "kind": "structure", "position": [12, 0, 6], "interactions": ["deploy_solar"]}
