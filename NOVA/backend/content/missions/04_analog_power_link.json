          {"min": 90, "value": 10, "reason": {"en": "Clean, isolated installation: extra reserve.", "ar": "Clean, isolated installation: extra reserve."}},
          {"min": 60, "value": 4, "reason": {"en": "Acceptable installation.", "ar": "Acceptable installation."}},
          {"min": 0, "value": -8, "reason": {"en": "Arc damage left the bus lossy.", "ar": "Arc damage left the bus lossy."}}
        ]
      }
    ]
  },
  "science_notes": [
