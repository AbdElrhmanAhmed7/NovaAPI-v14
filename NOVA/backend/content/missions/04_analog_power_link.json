{
  "id": "analog_power_link",
  "stage": 2,
  "title": {"en": "Connect the Power Module", "ar": "Connect the Power Module"},
  "summary": {"en": "Isolate the breaker, connect a power module, deploy a panel and energise the bus.", "ar": "Isolate the breaker, connect a power module, deploy a panel and energise the bus."},
  "environment": "earth_analog",
  "estimated_minutes": 7,
  "requires_missions": ["analog_systems_check"],
  "briefing": [
    {"en": "Never connect a module to a live bus.", "ar": "Never connect a module to a live bus."},
    {"en": "Power you save here is power you land with on Mars.", "ar": "Power you save here is power you land with on Mars."}
  ],
  "objectives": [
    {
      "id": "inspect_bus",
      "title": {"en": "Inspect the distribution bus", "ar": "Inspect the distribution bus"},
      "hint": {"en": "Measure each branch before touching anything.", "ar": "Measure each branch before touching anything."},
      "target": "power_panel",
      "animation": "measure",
      "duration_ms": 1600,
      "requires": [{"type": "item", "id": "multimeter"}],
      "effects": {"world": {"power.bus_ok": true}, "resources": {"power": -1}, "equipment_wear": {"multimeter": 2}},
      "score": 10
    },
    {
      "id": "isolate_breaker",
      "title": {"en": "Isolate the main breaker", "ar": "Isolate the main breaker"},
      "hint": {"en": "Lock the breaker open and tag it.", "ar": "Lock the breaker open and tag it."},
      "target": "main_breaker",
      "animation": "turn_valve",
      "duration_ms": 1800,
      "requires": [{"type": "item", "id": "wrench"}, {"type": "objective", "id": "inspect_bus"}],
      "effects": {"world": {"power.isolated": true}, "flags_set": ["power.isolated"], "equipment_wear": {"wrench": 3}},
      "score": 12,
      "success_message": {"en": "Bus isolated and tagged out.", "ar": "Bus isolated and tagged out."}
    },
    {
      "id": "fetch_power_module",
      "title": {"en": "Collect the power module and panel", "ar": "Collect the power module and panel"},
      "hint": {"en": "Stores: power cell and a folded solar panel.", "ar": "Stores: power cell and a folded solar panel."},
      "target": "stores_locker",
      "animation": "pickup",
      "duration_ms": 1400,
      "require_previous": false,
      "effects": {"items": {"power_cell": 1, "solar_panel": 1}},
      "score": 8
    },
    {
      "id": "connect_module",
      "title": {"en": "Connect the power module", "ar": "Connect the power module"},
      "hint": {"en": "Only safe while the breaker is isolated.", "ar": "Only safe while the breaker is isolated."},
      "target": "power_module_bay",
      "animation": "install",
      "duration_ms": 2600,
      "requires": [
        {"type": "item", "id": "power_cell"},
        {"type": "flag", "id": "power.isolated", "hint": {"en": "Isolate the breaker first.", "ar": "Isolate the breaker first."}}
      ],
      "effects": {"items": {"power_cell": -1}, "world": {"power.module_connected": true}},
      "score": 16
    },
    {
      "id": "deploy_solar",
      "title": {"en": "Deploy the solar panel", "ar": "Deploy the solar panel"},
      "hint": {"en": "Mount the panel on the external frame.", "ar": "Mount the panel on the external frame."},
      "target": "solar_frame",
      "animation": "install",
      "duration_ms": 2400,
      "requires": [{"type": "item", "id": "solar_panel"}, {"type": "objective", "id": "connect_module"}],
      "effects": {"items": {"solar_panel": -1}, "world": {"power.solar_deployed": true}},
      "score": 12
    },
    {
      "id": "energise_bus",
      "title": {"en": "Energise the bus", "ar": "Energise the bus"},
      "hint": {"en": "Close the breaker and watch the load ramp.", "ar": "Close the breaker and watch the load ramp."},
      "target": "main_breaker",
      "animation": "confirm",
      "duration_ms": 1600,
      "requires": [{"type": "world", "path": "power.module_connected", "op": "eq", "value": true}],
      "effects": {"world": {"power.online": true}, "flags_set": ["power_online"], "flags_clear": ["power.isolated"], "resources": {"power": 25}},
      "score": 14,
      "success_message": {"en": "Bus online (+25 kWh).", "ar": "Bus online (+25 kWh)."}
    }
  ],
  "hazards": [
    {
      "action": "connect_module",
      "missing_any": ["power.isolated"],
      "effects": {"resources": {"power": -8}},
      "message": {"en": "Arc flash! You connected a module to a live bus and tripped the branch.", "ar": "Arc flash! You connected a module to a live bus and tripped the branch."},
      "mistake_penalty": 8.0
    },
    {
      "action": "energise_bus",
      "missing_any": ["power.module_connected"],
      "effects": {"resources": {"power": -5}},
      "message": {"en": "Nothing to energise – the module bay is still empty.", "ar": "Nothing to energise – the module bay is still empty."},
      "mistake_penalty": 4.0
    }
  ],
  "scoring": {"mistake_penalty": 5.0, "time_target_seconds": 420.0, "time_bonus_max": 8.0, "pass_score_pct": 55.0},
  "completion": {
    "effects": {"world": {"analog.power_ok": true}},
    "unlocks": ["analog_comms_blackout", "analog_water_recycling"],
    "summary": {"en": "Habitat bus is online with solar support.", "ar": "Habitat bus is online with solar support."},
    "continuity": [
      {
        "key": "power:power",
        "label": {"en": "Power discipline → power reserve", "ar": "Power discipline → power reserve"},
