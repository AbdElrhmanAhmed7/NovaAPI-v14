# ---------------------------------------------------------------------------
# NOVA backend configuration. Copy to `.env` and adjust.
# Every variable is prefixed with NOVA_ and is optional (sane defaults exist).
# ---------------------------------------------------------------------------

NOVA_ENVIRONMENT=dev                     # dev | test | prod
NOVA_LOG_LEVEL=INFO
NOVA_LOG_JSON=true
# Shown by /api/v1/health and in the OpenAPI title.
NOVA_APP_NAME=NOVA – Beyond the Mission API
# The console, the typed client and the tests all assume /api/v1 – change only
# if you also regenerate the frontend client.
# NOVA_API_V1_PREFIX=/api/v1

# --- Database -------------------------------------------------------------
# SQLite by default. Any SQLAlchemy async URL works (e.g. postgresql+asyncpg://...)
NOVA_DATABASE_URL=sqlite+aiosqlite:///./data/nova.db
NOVA_DB_ECHO=false
# Create tables on startup instead of running Alembic (handy in dev/test).
NOVA_AUTO_CREATE_TABLES=true
# Connection pool for server databases (ignored by SQLite).
NOVA_DB_POOL_SIZE=5

# --- CORS -----------------------------------------------------------------
# Comma separated origins, or * for local development.
NOVA_FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional regex, useful for preview deployments (Vercel/Netlify/e2b...).
NOVA_CORS_ORIGIN_REGEX=https://.*\.(e2b\.app|vercel\.app|netlify\.app)

# --- Request limits -------------------------------------------------------
# Bodies larger than this are rejected with 413 (save imports are the biggest).
NOVA_MAX_REQUEST_BYTES=256000

# --- Security -------------------------------------------------------------
# When true, mutating game endpoints require the `X-Session-Token` returned by
# POST /api/v1/games. Leave false while prototyping the frontend.
NOVA_AUTH_ENABLED=false
NOVA_SECRET_KEY=change-me-in-production
NOVA_TOKEN_TTL_HOURS=72
# Optional global API key (header `X-API-Key`) for server-to-server calls.
NOVA_API_KEY=

# --- Rate limiting --------------------------------------------------------
NOVA_RATE_LIMIT_ENABLED=true
NOVA_RATE_LIMIT_REQUESTS=1800
NOVA_RATE_LIMIT_WINDOW_SECONDS=60

# --- Gameplay -------------------------------------------------------------
NOVA_DEFAULT_DIFFICULTY=standard         # cadet | standard | veteran
NOVA_MAX_TICK_SECONDS=5
NOVA_SESSION_TTL_HOURS=168
NOVA_MAX_EVENTS_PER_SESSION=2000
# Hard cap on stored campaigns: creating or importing one beyond it is
# refused with `session_limit` (409) instead of filling the disk.
NOVA_MAX_SESSIONS=5000
# Mission blueprints, items, science and NASA fallbacks. Defaults to the
# packaged `content/` folder – use an absolute path for an external pack.
# NOVA_CONTENT_DIR=./content

# --- Live event stream (WS /api/v1/games/{id}/stream) ----------------------
# The stream is a read model over the event log: the bus notifies, the log
# remains the source of truth, and a reconnect with after_seq never loses an
# event. Lower the timers for demos, raise them for many idle spectators.
NOVA_STREAM_HEARTBEAT_SECONDS=15
# Safety net for multi-worker deployments (the bus is process-local).
NOVA_STREAM_RECONCILE_SECONDS=5
# Events per replay page (initial connect, resume, re-sync).
NOVA_STREAM_BATCH_SIZE=200
# Buffered frames per socket; a slow consumer gets stream.resync, not silence.
NOVA_STREAM_QUEUE_SIZE=256
NOVA_STREAM_MAX_CONNECTIONS_PER_GAME=8

# --- NASA open data -------------------------------------------------------
# Get a free key at https://api.nasa.gov  (DEMO_KEY is heavily rate limited)
NOVA_NASA_API_KEY=DEMO_KEY
NOVA_NASA_ENABLED=true
NOVA_NASA_BASE_URL=https://api.nasa.gov
NOVA_NASA_TIMEOUT_SECONDS=8
NOVA_NASA_CACHE_TTL_SECONDS=900
NOVA_NASA_MAX_RETRIES=2

# --- Content validation ---------------------------------------------------
# Static mission-content checks at startup (reachability, references, i18n).
NOVA_VALIDATE_CONTENT=true
# Refuse to boot if a mission is authored in an unwinnable way.
NOVA_VALIDATE_CONTENT_STRICT=true
